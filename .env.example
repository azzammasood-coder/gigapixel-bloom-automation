# Copy this file to ".env" and fill in the values. Never commit the real .env.

# --- Topaz Labs (required) ---
# Create/find your key at https://developer.topazlabs.com  (Account -> API keys)
TOPAZ_API_KEY=your-topaz-api-key-here

# --- LLM vision step (optional) ---
# If left blank, the tool skips the AI step and uses the default settings in config.yaml.
# OpenRouter is recommended (cheap, many vision models). Get a key at https://openrouter.ai/keys
LLM_API_KEY=
# OpenAI-compatible base URL. OpenRouter default shown below.
LLM_BASE_URL=https://openrouter.ai/api/v1
# A vision-capable model id.
LLM_MODEL=openai/gpt-4o-mini
